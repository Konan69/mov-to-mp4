<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MovToMp4">

        <!-- Ask the system for the original bytes: without this it may hand an
             HEVC or HDR video over already transcoded to H.264. -->
        <property
            android:name="android.media.PROPERTY_MEDIA_CAPABILITIES"
            android:resource="@xml/media_capabilities" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" on a .mov in WhatsApp, Files, Gmail, Drive and so on.
                 video/* is here on purpose: once Android's media scanner has read a
                 .mov it files it under video/mp4, and apps pass that type along. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/x-quicktime" />
                <data android:mimeType="video/mov" />
                <data android:mimeType="application/x-quicktimeplayer" />
            </intent-filter>

            <!-- Apps that open a .mov with a generic or wrong type: match on the name. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\..*\\.mov" />
                <data android:pathPattern=".*\\..*\\..*\\.mov" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.mov" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\..*\\.MOV" />
                <data android:pathPattern=".*\\..*\\..*\\.MOV" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.MOV" />
                <data android:pathPattern=".*\\.qt" />
            </intent-filter>
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\..*\\.mov" />
                <data android:pathPattern=".*\\..*\\..*\\.mov" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\..*\\.MOV" />
                <data android:pathPattern=".*\\..*\\..*\\.MOV" />
            </intent-filter>

            <!-- Share sheet, one file or several. -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".ConvertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
